# Local development defaults to SQLite. Set DATABASE_URL only when using PostgreSQL.
DJANGO_SECRET_KEY=replace-this-for-any-shared-environment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Example: postgres://english_learning:password@localhost:5432/english_learning
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
